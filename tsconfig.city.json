{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/views/city-rendering/*.ts",
    "src/views/city-rendering/*.vue",
    "src/water/*.ts"
  ],
  "exclude": ["src/types"]
}
