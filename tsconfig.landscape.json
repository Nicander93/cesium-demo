{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/views/landscape-showcase/**/*.ts",
    "src/views/landscape-showcase/**/*.vue",
    "src/environment/**/*.ts",
    "src/water/**/*.ts"
  ]
}
