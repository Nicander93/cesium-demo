{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/environment/**/*.ts",
    "src/views/environment-lab/**/*.ts",
    "src/views/environment-lab/**/*.vue"
  ]
}
