{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/views/model-rendering/*.ts",
    "src/views/model-rendering/*.vue"
  ],
  "exclude": [
    "src/types"
  ]
}
