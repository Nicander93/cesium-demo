    "vite-plugin-cesium": "^1.2.23",
    "cesium": "1.132.0",
    "vue": "^3.5.13",
    "vue-router": "4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/ui": "^3.2.4",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.8",
    "@types/three": "0.180.0",
    "ktx-parse": "1.1.0"
  }
